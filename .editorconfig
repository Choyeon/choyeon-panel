# choyeon-panel: 编辑器统一约定
# 与 .gitattributes 的 `* text=auto eol=lf` 配套：前者管提交内容，这里管编辑时的落盘。
# shell 脚本一旦带 CRLF，在 Linux 上会报 `$'\r': command not found`。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown 用两个行尾空格表示硬换行，不能统一裁掉
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{png,ico,jpg,woff,woff2}]
insert_final_newline = false
trim_trailing_whitespace = false
