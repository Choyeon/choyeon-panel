# choyeon-panel 环境变量样例
# 复制为 .env 或直接写入 systemd unit 的 Environment= 行。
# 全部可选，未设置时使用括号内的默认值。

# 监听地址与端口（默认 127.0.0.1:3210；置于 nginx 反代后保持本机回环）
CP_HOST=127.0.0.1
CP_PORT=3210

# 是否信任反向代理的 X-Forwarded-For（用于登录限速按真实 IP 计数）
# 直接暴露公网或有 nginx 反代时设为 1
CP_TRUST_PROXY=1

# 数据目录：panel.db、jwt 密钥、审计日志（默认 server/data）
CP_DATA_DIR=/root/choyeon-panel/data

# 文件管理允许访问的根目录，逗号分隔
CP_FILE_ROOTS=/root/www,/etc/nginx,/root/backups/panel

# 开启结构化请求日志（pino info 级别；设置任意值即开启）
# CP_LOG=1

# Python 系统助手解释器（默认 python3；见 server/python/sys_helper.py）
CP_PYTHON=python3
