# choyeon-panel 环境变量样例
# 复制为 .env 或直接写入 systemd unit 的 Environment= 行。
# 全部可选，未设置时使用括号内的默认值。
# 加载优先级（后者更高）：内置默认 < .env < 进程环境变量（systemd Environment=）

# ---------- 监听 ----------
# 监听地址与端口（默认 127.0.0.1:3210；置于 nginx 反代后保持本机回环）
CP_HOST=127.0.0.1
CP_PORT=3210

# 是否采信请求头里的 X-Real-IP / X-Forwarded-For（登录限速按真实 IP 计数）
# 仅在面板前面有本机反向代理时设为 1；直接暴露公网请保持关闭
CP_TRUST_PROXY=1

# 允许采信上述请求头的 TCP 对端，逗号分隔（默认 127.0.0.1,::1）
# 只有对端确实在这份名单里，转来的 IP 才会被当作真实客户端地址；
# 否则本机任何进程都能绕过 nginx 直连回环端口伪造 X-Real-IP，把限速变成空桶。
# 反向代理装在另一台机器上时，把那台机器的地址加进来。
# CP_TRUSTED_PROXIES=127.0.0.1,::1

# 是否发送 HSTS 响应头。仅在面板直接对外提供 HTTPS 时开启；
# 走 nginx 反代时保持 0（由 nginx 统一发送），否则会重复设置
# CP_HSTS=0

# 调试开关：设置任意值即开启 uvicorn info 日志，并在错误响应体里回显异常详情
# 生产环境不要开启（错误信息会泄露路径与内部实现）
# CP_LOG=1

# ---------- 路径 ----------
# 数据目录：panel.db、jwt 密钥、头像（默认为安装目录下的 data/）
CP_DATA_DIR=/root/choyeon-panel/data

# 应用部署根目录
CP_APP_ROOT=/root/www

# 备份存放目录
CP_BACKUP_DIR=/root/backups/panel

# 文件管理允许访问的根目录，逗号分隔（必须为绝对路径）
CP_FILE_ROOTS=/root/www,/etc/nginx,/root/backups/panel

# systemd 单元目录 / nginx 配置目录 / Let's Encrypt 证书目录
CP_UNIT_DIR=/etc/systemd/system
CP_NGINX_CONF_DIRS=/etc/nginx/conf.d,/etc/nginx/sites-available
CP_TLS_DIR=/etc/letsencrypt/live

# Python 系统助手解释器（默认 python3；见 backend/python/sys_helper.py）
CP_PYTHON=python3

# ---------- 安全与限额 ----------
# 登录令牌有效期（小时，1-72）
CP_TOKEN_TTL_HOURS=12

# 登录失败限速：每 IP 每分钟允许次数（1-100）
CP_LOGIN_LIMIT=10

# 单文件上传体积上限（MB，1-512）。nginx 的 client_max_body_size 需 >= 此值
CP_MAX_UPLOAD_MB=8

# 其余接口（JSON 表单、SQL 控制台等）的请求体上限（MB，1-64）
# 上传类接口按 CP_MAX_UPLOAD_MB + 4MB 计，这条只管非上传路由
CP_MAX_BODY_MB=2

# 解压上限（MB，16-8192 / 文件数 10-200000）
# 压缩包体积被 CP_MAX_UPLOAD_MB 卡住，但 8MB 的 zip 能在头部声明 5GB 的
# 解压后尺寸（zip bomb）。面板以 root 运行，写满磁盘只需要点一次"解压"。
CP_MAX_EXTRACT_MB=512
CP_MAX_EXTRACT_FILES=5000

# 头像上传体积上限（KB，32-16384）。头像在浏览器本地压缩到 256px JPEG，通常 20-80KB
CP_AVATAR_MAX_KB=2048

# 并发终端会话数上限（1-32）
CP_TERMINAL_MAX_SESSIONS=4

# 终端输出缓冲水位（KB，256-65536）
# 浏览器读得慢时 pty 输出会在队列里堆积，`yes` 这类命令几秒就能堆到几百 MB；
# 超过水位主动断开该会话，而不是等 OOM 把整个面板带走。
CP_TERMINAL_OUT_BUFFER_KB=4096

# 审计日志保留条数（>=100，超出部分由后台任务定期裁剪）
CP_AUDIT_KEEP=5000
