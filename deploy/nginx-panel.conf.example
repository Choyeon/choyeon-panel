# choyeon-panel 反向代理示例
# 放置位置：
#   Debian 系：/etc/nginx/sites-available/choyeon-panel  -> ln -s 到 sites-enabled/
#   RHEL  系：/etc/nginx/conf.d/choyeon-panel.conf
#
# ⚠️ 复制后必须替换：server_name 与 ssl_certificate* 路径。
# ⚠️ 修改前先备份现有配置；改完必须先 nginx -t 再 systemctl reload nginx。
#
# 面板默认只监听 127.0.0.1:3210，不要把它直接暴露到公网。

server {
    listen 443 ssl;
    http2 on;
    server_name panel.example.com;

    # ---- TLS ----
    ssl_certificate     /etc/letsencrypt/live/panel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # 已生成 dhparam（openssl dhparam -out /etc/nginx/dhparam.pem 2048）后可启用：
    # ssl_dhparam /etc/nginx/dhparam.pem;

    # ---- 响应头 ----
    # CSP / X-Content-Type-Options / Referrer-Policy / Permissions-Policy 由后端统一注入
    #（见 backend/app/deps.py），这里不再重复设置，避免两层 add_header 互相覆盖。
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # 上传上限需 >= 后端 CP_MAX_UPLOAD_MB（默认 8MB），否则大文件会在 nginx 层被 413 拦下
    client_max_body_size 20m;
    client_body_timeout 60s;

    access_log /var/log/nginx/choyeon-panel.access.log;
    error_log  /var/log/nginx/choyeon-panel.error.log warn;

    # ---- 登录接口限速（可选，需先在 http{} 段定义共享内存区）：----
    #   limit_req_zone $binary_remote_addr zone=cp_login:10m rate=10r/m;
    #   limit_req_status 429;
    # 定义后取消下面 4 行注释即可生效，与后端"每 IP 每分钟 N 次"共同防口令爆破：
    # location = /api/auth/login {
    #     limit_req zone=cp_login burst=5 nodelay;
    #     proxy_pass http://127.0.0.1:3210;
    # }

    location / {
        proxy_pass http://127.0.0.1:3210;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 终端
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # SSE 实时日志：必须关闭缓冲，否则日志会卡住不刷新
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
    }
}

server {
    listen 80;
    server_name panel.example.com;
    # ACME 校验路径必须放行，否则证书续期会失败
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}
